# Copiar como .env y completar solo con datos de una base local independiente.
# Esta plantilla no conecta ni crea una base de datos.
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=
# Opcional: clave privada dedicada de al menos 32 caracteres para cifrar TOTP.
# Si se deja vacía se deriva de SECRET_KEY, que debe ser estable y privada.
# No cambiar la clave usada con usuarios vinculados sin planificar su recuperación.
MFA_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Para dispositivos en la Wi-Fi: agregar aquí el origen exacto de la vista móvil.
# Ejemplo de formato: https://IP_DE_TU_PC:4173 (sin barra final).
FRONTEND_ORIGINS=
# Opcional: clave JWT independiente; si está vacía se utiliza SECRET_KEY.
JWT_SECRET_KEY=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=puntocom_pos
DB_USER=postgres
DB_PASSWORD=
# En la nube se usa DATABASE_URL, configurada únicamente en Render.
# Tiene prioridad sobre DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
DATABASE_URL=
TRUST_PROXY=false
